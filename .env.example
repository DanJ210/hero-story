# hero-story .env.example
# Copy this file to .env and fill in CHANGEME values before running locally.
# NEVER commit .env with real values. .env is gitignored.

# Database
DB_CONNECTION_STRING=Server=localhost,1433;Database=HeroStoryDb;User Id=sa;Password=CHANGEME_SqlPassword1!;TrustServerCertificate=True
DB_APPLY_MIGRATIONS=true

# JWT Authentication
JWT_SECRET=CHANGEME_generate_with_openssl_rand_base64_32
JWT_ISSUER=http://localhost:8080
JWT_AUDIENCE=http://localhost:5173
JWT_EXPIRES_MINUTES=15
JWT_REFRESH_EXPIRES_DAYS=7

# OpenAI
OPENAI_API_KEY=sk-CHANGEME
OPENAI_TEXT_MODEL=gpt-4o
OPENAI_TEXT_MAX_TOKENS=800
OPENAI_TEXT_TEMPERATURE=0.85
OPENAI_MODERATION_MODEL=text-moderation-latest
OPENAI_REQUEST_TIMEOUT_SECONDS=30

# Azure Blob Storage
AZURE_BLOB_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_BLOB_IMAGES_CONTAINER=images
AZURE_BLOB_ASSETS_CONTAINER=assets
AZURE_BLOB_SAS_EXPIRY_HOURS=24
AZURE_BLOB_SAS_RENEW_THRESHOLD_MINUTES=60

# Azure Queue Storage
AZURE_QUEUE_CONNECTION_STRING=UseDevelopmentStorage=true
AZURE_QUEUE_IMAGE_JOBS_NAME=image-generation-jobs
AZURE_QUEUE_POISON_NAME=image-generation-jobs-poison
AZURE_QUEUE_POLL_INTERVAL_SECONDS=5
AZURE_QUEUE_VISIBILITY_TIMEOUT_SECONDS=30
AZURE_QUEUE_MAX_DEQUEUE_COUNT=3

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Moderation
MODERATION_KEYWORD_LIST_PATH=/app/config/keywords.txt
MODERATION_MAX_SESSION_FAILURES=3

# Observability
LOG_LEVEL=Information
LOG_FORMAT=text

# API Server
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
RATE_LIMIT_ENABLED=true
IMAGE_STRATEGY=placeholder

# Frontend (Vite)
VITE_API_BASE_URL=http://localhost:8080/api
VITE_APP_TITLE=Hero Story
VITE_IMAGE_POLL_INTERVAL_MS=3000

# SQL Server Docker
MSSQL_SA_PASSWORD=CHANGEME_SqlPassword1!
ACCEPT_EULA=Y
